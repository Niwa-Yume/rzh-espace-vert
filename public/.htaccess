# Infomaniak (Apache) — utilisé seulement si le site est hébergé chez Infomaniak
ErrorDocument 404 /404.html
Options -Indexes

# Forcer HTTPS + domaine sans www
RewriteEngine On
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://rzh-espacesverts.ch%{REQUEST_URI} [L,R=301]

# Cache long pour les fichiers versionnés d'Astro
<IfModule mod_headers.c>
  <FilesMatch "\.(webp|jpg|png|svg|woff2|mp4|css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>
