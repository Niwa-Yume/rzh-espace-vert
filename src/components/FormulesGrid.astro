---
import Icon from './Icon.astro';
import { formules } from '../data/site';
---
<div class="fg">
  {formules.map((f, i) => (
    <article class:list={['fg__card reveal', f.featured && 'is-featured']} style={`transition-delay:${i * 90}ms`}>
      {f.featured && <span class="fg__badge">Le plus demandé</span>}
      <div class="fg__top">
        <span class="fg__icon"><Icon name={f.icon} size={26} /></span>
        <h3 class="fg__name">{f.name}</h3>
      </div>
      <p class="fg__title">{f.title}</p>
      <p class="fg__text">{f.text}</p>
      <ul class="leaf-list fg__list">
        {f.items.map((it) => <li><Icon name="Check" size={18} stroke={2} /><span>{it}</span></li>)}
      </ul>
      <div class="fg__foot">
        <p class="fg__price">{f.price ? <>À partir de <strong>CHF {f.price}</strong> / mois</> : <strong>Sur devis</strong>}</p>
        <a class:list={['btn', f.featured ? 'btn--primary' : 'btn--dark']} href={`/contact/?formule=${f.id}#devis`}>Demander un devis</a>
      </div>
    </article>
  ))}
</div>
<p class="fg__note reveal">Chaque formule est adaptée à la superficie, à la configuration et aux besoins de la propriété. Les tarifs sont établis après évaluation du terrain.</p>
<style>
  .fg { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; align-items: stretch; }
  .fg__card { position: relative; display: flex; flex-direction: column; gap: 14px; background: var(--paper); border: 1px solid var(--line); border-radius: var(--radius); padding: 36px 30px 30px; }
  .fg__card.is-featured { background: var(--green-900); color: var(--cream); border-color: var(--green-900); box-shadow: var(--shadow); }
  .fg__badge { position: absolute; top: -13px; left: 30px; background: var(--leaf); color: var(--green-950); font-size: .75rem; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; padding: 4px 12px; border-radius: 999px; }
  .fg__top { display: flex; align-items: center; gap: 14px; }
  .fg__icon { display: grid; place-items: center; width: 50px; height: 50px; border-radius: 50%; background: var(--leaf-soft); color: var(--green-900); }
  .is-featured .fg__icon { background: rgb(118 176 67 / .2); color: var(--leaf-bright); }
  .fg__name { font-family: var(--font-caps); font-size: 1.35rem; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; }
  .fg__title { font-family: var(--font-display); font-size: 1.25rem; line-height: 1.3; }
  .fg__text { color: var(--muted); font-size: .98rem; }
  .is-featured .fg__text { color: rgb(244 241 233 / .7); }
  .fg__list { padding-top: 10px; border-top: 1px solid var(--line); font-size: .97rem; flex: 1; }
  .is-featured .fg__list { border-color: rgb(244 241 233 / .15); }
  .is-featured .fg__list :global(.icon) { color: var(--leaf-bright); }
  .fg__foot { display: grid; gap: 16px; padding-top: 18px; }
  .fg__price { font-size: 1.05rem; }
  .fg__price strong { font-family: var(--font-display); font-size: 1.45rem; font-weight: 600; }
  .fg__note { margin-top: 32px; text-align: center; color: var(--muted); max-width: 720px; margin-inline: auto; font-style: italic; }
  @media (max-width: 960px) { .fg { grid-template-columns: 1fr; max-width: 560px; margin-inline: auto; } }
</style>
