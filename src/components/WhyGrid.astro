---
import { why } from '../data/site';
---
<ol class="wg">
  {why.map((w, i) => (
    <li class="wg__item reveal" style={`--d:${(i % 3) * 80}ms`}>
      <span class="wg__num">{String(i + 1).padStart(2, '0')}</span>
      <h3 class="wg__title">{w.title}</h3>
      <p class="muted">{w.text}</p>
    </li>
  ))}
</ol>
<style>
  .wg { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(32px, 4vw, 56px) clamp(24px, 4vw, 48px); }
  .wg__item { position: relative; display: grid; gap: 10px; align-content: start; padding-top: 22px; border-top: 1.5px solid var(--line); }
  :global(.js) .wg__item.reveal { transition: opacity .8s ease var(--d), transform .8s ease var(--d); }
  /* Ligne qui se trace de gauche à droite à l'apparition, verte au survol */
  .wg__item::before { content: ''; position: absolute; left: 0; top: -1.5px; width: 100%; height: 1.5px; background: var(--green-900); transform-origin: left; transition: transform 1.1s cubic-bezier(.65, 0, .35, 1) calc(var(--d) + .15s), background .3s; }
  :global(.js) .wg__item.reveal:not(.is-in)::before { transform: scaleX(0); }
  .wg__item:hover::before { background: var(--leaf); }
  :global(.js) .wg__item.is-in .wg__num { animation: wg-up .6s ease calc(var(--d) + .45s) backwards; }
  .wg__num { justify-self: start; transition: transform .3s ease, color .3s; }
  .wg__item:hover .wg__num { transform: translateX(6px); color: var(--green-900); }
  @keyframes wg-up { from { opacity: 0; transform: translateY(10px); } }
  @media (prefers-reduced-motion: reduce) {
    :global(.js) .wg__item.reveal { transition: none; }
    :global(.js) .wg__item.reveal:not(.is-in)::before { transform: none; }
    :global(.js) .wg__item.is-in .wg__num { animation: none; }
    .wg__item:hover .wg__num { transform: none; }
  }
  .wg__num { font-family: var(--font-caps); font-size: .85rem; letter-spacing: .2em; color: var(--leaf); font-weight: 600; }
  .wg__title { font-size: 1.35rem; }
  @media (max-width: 900px) { .wg { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 600px) { .wg { grid-template-columns: 1fr; } }
</style>
