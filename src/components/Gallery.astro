---
import { Image } from 'astro:assets';
import { realisations } from '../data/realisations';
interface Props { limit?: number }
const { limit } = Astro.props;
const items = limit ? realisations.slice(0, limit) : realisations;
---
<div class="gal">
  {items.map((r, i) => (
    <figure class:list={['gal__item reveal', r.wide && 'gal__item--wide']}>
      <button type="button" class="gal__btn" data-full={r.img.src} data-alt={r.alt} aria-label={`Agrandir : ${r.alt}`}>
        <Image src={r.img} alt={r.alt} widths={[400, 700, 1000]} sizes="(max-width: 640px) 100vw, (max-width: 1000px) 50vw, 33vw" loading={i < 3 ? 'eager' : 'lazy'} />
      </button>
      <figcaption class="gal__cap">
        <span class="gal__type">{r.type}</span>
        <span class="gal__works">{r.works.join(' · ')}</span>
        <span class="gal__loc">Région genevoise</span>
      </figcaption>
    </figure>
  ))}
</div>

<dialog class="lb" data-lb>
  <form method="dialog"><button class="lb__close" aria-label="Fermer">×</button></form>
  <img alt="" data-lb-img />
</dialog>

<script>
  const lb = document.querySelector<HTMLDialogElement>('[data-lb]');
  const img = document.querySelector<HTMLImageElement>('[data-lb-img]');
  document.querySelectorAll<HTMLButtonElement>('.gal__btn').forEach((b) => {
    b.addEventListener('click', () => {
      if (!lb || !img) return;
      img.src = b.querySelector('img')?.currentSrc || b.dataset.full!;
      img.alt = b.dataset.alt || '';
      lb.showModal();
    });
  });
  lb?.addEventListener('click', (e) => { if (e.target === lb) lb.close(); });
</script>

<style>
  .gal { columns: 3 300px; column-gap: 20px; }
  .gal__item { break-inside: avoid; margin: 0 0 20px; position: relative; border-radius: var(--radius); overflow: hidden; background: var(--green-900); }
  .gal__btn { all: unset; display: block; cursor: zoom-in; width: 100%; }
  .gal__btn :global(img) { width: 100%; transition: transform .6s ease, opacity .4s; }
  .gal__item:hover .gal__btn :global(img) { transform: scale(1.03); opacity: .92; }
  .gal__btn:focus-visible { outline: 3px solid var(--leaf); outline-offset: -3px; }
  .gal__cap { position: absolute; left: 0; right: 0; bottom: 0; padding: 48px 20px 18px; display: grid; gap: 2px; color: var(--cream); background: linear-gradient(to top, rgb(11 29 19 / .88), transparent); pointer-events: none; }
  .gal__type { font-family: var(--font-display); font-size: 1.2rem; }
  .gal__works { font-size: .88rem; color: rgb(244 241 233 / .8); }
  .gal__loc { font-family: var(--font-caps); font-size: .65rem; letter-spacing: .2em; text-transform: uppercase; color: var(--leaf-bright); margin-top: 6px; }

  .lb { padding: 0; border: 0; background: transparent; max-width: 94vw; max-height: 92vh; }
  .lb::backdrop { background: rgb(11 29 19 / .9); }
  .lb img { max-width: 94vw; max-height: 92vh; width: auto; border-radius: 10px; }
  .lb__close { position: fixed; top: 14px; right: 18px; width: 44px; height: 44px; border-radius: 50%; border: 0; background: var(--cream); color: var(--green-900); font-size: 1.6rem; cursor: pointer; }
</style>
