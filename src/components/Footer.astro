---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { nav, site } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="ftr">
  <div class="container ftr__grid">
    <div class="ftr__brand">
      <Logo tone="light" />
      <p class="ftr__tag">{site.tagline} — Genève</p>
      <p class="ftr__aud">{site.audiences.join(' · ')}</p>
    </div>

    <nav aria-label="Pied de page">
      <h2 class="ftr__h">Navigation</h2>
      <ul class="ftr__list">
        {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
      </ul>
    </nav>

    <div>
      <h2 class="ftr__h">Contact</h2>
      <ul class="ftr__list ftr__contact">
        <li><Icon name="UserRound" size={18} /> <span>{site.manager}, {site.managerRole.toLowerCase()}</span></li>
        <li><Icon name="Phone" size={18} /> <a href={`tel:${site.phoneHref}`}>{site.phone}</a></li>
        <li><Icon name="Mail" size={18} /> <a href={`mailto:${site.email}`}>{site.email}</a></li>
        <li><Icon name="MapPin" size={18} /> <span>{site.address.street}<br />{site.address.zip} {site.address.city}</span></li>
      </ul>
    </div>
  </div>
  <div class="container ftr__bottom">
    <span>© {year} {site.name} — Tous droits réservés</span>
    <a href="/mentions-legales/">Mentions légales & confidentialité</a>
  </div>
</footer>

<style>
  .ftr { background: var(--green-950); color: var(--cream); padding-top: clamp(56px, 8vw, 88px); }
  .ftr__grid { display: grid; grid-template-columns: 1.3fr 1fr 1.2fr; gap: 48px; padding-bottom: 56px; }
  .ftr__brand { display: grid; gap: 14px; justify-items: start; align-content: start; }
  .ftr__tag { font-family: var(--font-display); font-style: italic; font-size: 1.1rem; margin-top: 8px; }
  .ftr__aud { font-family: var(--font-caps); font-size: .72rem; letter-spacing: .24em; text-transform: uppercase; color: var(--leaf); }
  .ftr__h { font-family: var(--font-caps); font-size: .78rem; font-weight: 600; letter-spacing: .24em; text-transform: uppercase; color: rgb(244 241 233 / .55); margin-bottom: 18px; }
  .ftr__list { display: grid; gap: 10px; }
  .ftr__list a { text-decoration: none; color: rgb(244 241 233 / .85); }
  .ftr__list a:hover { color: var(--leaf-bright); }
  .ftr__contact li { display: grid; grid-template-columns: 18px 1fr; gap: 12px; align-items: start; color: rgb(244 241 233 / .85); }
  .ftr__contact :global(.icon) { color: var(--leaf); margin-top: 4px; }
  .ftr__bottom { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px; padding-block: 24px; border-top: 1px solid rgb(244 241 233 / .12); font-size: .88rem; color: rgb(244 241 233 / .55); }
  .ftr__bottom a { color: inherit; }
  @media (max-width: 820px) { .ftr__grid { grid-template-columns: 1fr; gap: 36px; } }
</style>
