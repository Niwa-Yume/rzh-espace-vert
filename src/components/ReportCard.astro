---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
const lines = ['Tonte effectuée', 'Bordures et finitions réalisées', 'Haies contrôlées', 'Espaces extérieurs nettoyés', 'Déchets verts évacués', 'Photos prises'];
---
<figure class="rc">
  <div class="rc__head">
    <Logo />
    <span class="rc__label">Rapport d’intervention</span>
  </div>
  <dl class="rc__meta">
    <div><dt>Propriété</dt><dd>Immeuble — Nom / Adresse</dd></div>
    <div><dt>Date</dt><dd>12.05.2027</dd></div>
  </dl>
  <p class="rc__sub">Intervention</p>
  <ul class="rc__list">
    {lines.map((l) => <li><span class="rc__tick"><Icon name="Check" size={14} stroke={2.5} /></span>{l}</li>)}
  </ul>
  <figcaption class="rc__cap">Exemple de rapport transmis après intervention</figcaption>
</figure>
<style>
  .rc { margin: 0; background: var(--paper); color: var(--ink); border-radius: var(--radius); padding: 30px; box-shadow: 0 30px 60px -20px rgb(0 0 0 / .45); rotate: -1.5deg; max-width: 420px; width: 100%; }
  .rc__head { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding-bottom: 18px; border-bottom: 1px solid var(--line); }
  .rc__label { font-family: var(--font-caps); font-size: .7rem; letter-spacing: .2em; text-transform: uppercase; color: var(--muted); text-align: right; }
  .rc__meta { margin: 18px 0 0; display: grid; gap: 8px; font-size: .92rem; }
  .rc__meta div { display: grid; grid-template-columns: 90px 1fr; }
  .rc__meta dt { font-weight: 600; text-transform: uppercase; font-size: .75rem; letter-spacing: .1em; color: var(--muted); padding-top: 3px; }
  .rc__meta dd { margin: 0; }
  .rc__sub { margin-top: 18px; font-weight: 600; text-transform: uppercase; font-size: .75rem; letter-spacing: .1em; color: var(--muted); }
  .rc__list { margin-top: 10px; display: grid; gap: 9px; font-size: .97rem; }
  .rc__list li { display: flex; align-items: center; gap: 10px; }
  .rc__tick { display: grid; place-items: center; width: 22px; height: 22px; border-radius: 6px; background: var(--leaf); color: var(--green-950); flex-shrink: 0; }
  .rc__cap { margin-top: 20px; padding-top: 14px; border-top: 1px dashed var(--line); font-size: .82rem; color: var(--muted); font-style: italic; }
</style>
