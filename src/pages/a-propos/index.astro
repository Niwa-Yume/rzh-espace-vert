---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Story from '../../components/Story.astro';
import SectionHead from '../../components/SectionHead.astro';
import WhyGrid from '../../components/WhyGrid.astro';
import ZoneBlock from '../../components/ZoneBlock.astro';
import CtaBand from '../../components/CtaBand.astro';
---
<Base title="À propos" description="RZH Espaces Verts poursuit l’entreprise familiale de jardinage Rizahi à Genève, avec une nouvelle identité et une nouvelle génération.">
  <PageHero eyebrow="À propos" title="RZH, les initiales d’une famille de jardiniers genevois" text="Une entreprise familiale, une nouvelle génération." />
  <section class="section"><div class="container"><Story full /></div></section>
  <section class="section section--paper">
    <div class="container">
      <SectionHead eyebrow="Pourquoi RZH Espaces Verts ?" title="Soin, suivi et proximité" />
      <WhyGrid />
    </div>
  </section>
  <section class="section"><div class="container"><ZoneBlock /></div></section>
  <CtaBand />
</Base>
