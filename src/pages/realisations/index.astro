---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHead from '../../components/SectionHead.astro';
import BeforeAfter from '../../components/BeforeAfter.astro';
import Gallery from '../../components/Gallery.astro';
import CtaBand from '../../components/CtaBand.astro';
---
<Base title="Réalisations" description="Entretien de jardins, taille de haies, élagage, plantations et aménagements : quelques réalisations de RZH Espaces Verts dans la région genevoise.">
  <PageHero eyebrow="Nos réalisations" title="Découvrez notre travail" text="Chaque propriété est différente. Découvrez quelques-unes de nos réalisations." />
  <section class="section">
    <div class="container">
      <SectionHead eyebrow="Avant / après" title="La différence, en images" />
      <BeforeAfter />
    </div>
  </section>
  <section class="section section--paper">
    <div class="container">
      <SectionHead eyebrow="Galerie" title="Toutes nos réalisations" />
      <Gallery filters />
    </div>
  </section>
  <CtaBand />
</Base>
